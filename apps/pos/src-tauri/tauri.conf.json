{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Vua Ca",
  "version": "0.1.0",
  "identifier": "vn.vuaca.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "POS Vựa Cá",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
